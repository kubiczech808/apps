[Unit]
Description=BTC leveraged momentum bot - one pass
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/btc-bot.env
WorkingDirectory=%h/.local/lib/btc-bot
ExecStart=/usr/bin/env node tools/run-bot.mjs
# A pass is meant to take seconds. Keep this materially below the dashboard's
# stale-state threshold: a wedged market/API request must not prevent the next
# scheduled heartbeat for half an hour.
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/btc-bot
