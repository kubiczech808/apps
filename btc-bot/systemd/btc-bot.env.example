# Copy to ~/.config/btc-bot.env on the Raspberry Pi (chmod 600).
#
# The Pi is the primary runner. GitHub Actions runs the same code as a fallback
# and will only act when this runner has stopped renewing its lease.

BOT_RUNNER=rpi-primary-v2
BOT_API_URL=https://btc-dca.com/bot/api.php
# The dashboard key, and it must match what the deploy wrote into config.php.
# It is committed in btcbot-deploy.yml and therefore public; the bot refuses to
# trade mainnet while it is in use. Set a BTC_BOT_KEY secret on the repository
# and put the same value here to lift that.
BOT_API_KEY=ahoj1234567890
BOT_STATE_FILE=/home/openclaw2/.local/state/btc-bot/bot-state.json
# The 1D price-action structure reads 400 calendar days from hourly candles.
BOT_CANDLE_LIMIT=10000
# Refuse an incomplete upstream response and use the next market-data source.
BOT_MIN_CANDLE_HISTORY=9648
# Optional. FX reference trend uses one hourly Twelve Data batch; BTC uses the
# public Binance BTCUSDT feed and needs no key. Keep this only on the runner.
TWELVE_DATA_API_KEY=

# Only needed once the bot's mode is testnet4 or mainnet. In paper mode it runs
# without them and simply does not place orders.
LNM_API_KEY=
LNM_API_SECRET=
LNM_API_PASSPHRASE=
# LN Markets has no reachable public test network — both api.testnet.lnmarkets.com
# and api.testnet4.lnmarkets.com fail DNS. Paper mode is the substitute; see the
# README. This only chooses which network the client would talk to.
LNM_API_NETWORK=mainnet
