# This file is installed locally on the RPi with mode 0600. Never commit a real key.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=0x3252de913d9323667f21f4d88fa1f996fc282293
POLYMARKET_SIGNATURE_TYPE=3

# `shadow` records an exit decision but never submits a sell. The deployment starts here.
LIVE_EXIT_MODE=shadow
LIVE_EXIT_CONFIRM_LIVE=false
# `false` means only token IDs listed in the local watchlist are considered.
LIVE_EXIT_PROTECT_ALL=false
LIVE_EXIT_POLL_INTERVAL_MS=5000
LIVE_EXIT_RETRY_INTERVAL_MS=20000
LIVE_EXIT_STATE_REFRESH_MS=30000
LIVE_EXIT_STATE_PATH=/home/USER/.local/state/trading/live-exit-worker-state.json
LIVE_EXIT_WATCHLIST_PATH=/home/USER/.config/trading-live-exit-watchlist.json
# Set only after the existing live-account workflow has been verified for the RPi user.
LIVE_EXIT_POST_FILL_SYNC_COMMAND=

# The dip-entry rule: buy a favourite that has collapsed inside a fixture already under way.
# It lives in this worker rather than in the hourly executor because the trough lasts
# minutes, and this loop is already round every second with the signing key.
#
# `off` does not even fetch the watch list. `shadow` follows the watched markets and records
# what it WOULD buy, at the price it would have paid, without sending anything -- which is
# how the rule gets measured before it is trusted. `live` needs LIVE_EXIT_MODE=live and
# LIVE_EXIT_CONFIRM_LIVE=true as well, so arming it is a deliberate act in three places.
LIVE_DIP_ENTRY_MODE=off
# How long a watched market survives after the catalogue stops listing it. A collapsed
# favourite LEAVES the catalogue -- above 50% it is a row, at 35% it is not -- so the entry
# has to outlive the very collapse it is waiting for. Four hours covers a fixture.
LIVE_DIP_ENTRY_TTL_MS=14400000
LIVE_DIP_ENTRY_MAX_SLIPPAGE=0.02
