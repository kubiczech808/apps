# This file is installed locally on the RPi with mode 0600. Never commit a real key.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=0x3252de913d9323667f21f4d88fa1f996fc282293
POLYMARKET_SIGNATURE_TYPE=3

# `shadow` records an exit decision but never submits a sell. The deployment starts here.
LIVE_EXIT_MODE=shadow
LIVE_EXIT_CONFIRM_LIVE=false
# `false` means only token IDs listed in the local watchlist are considered.
LIVE_EXIT_PROTECT_ALL=false
LIVE_EXIT_POLL_INTERVAL_MS=5000
LIVE_EXIT_RETRY_INTERVAL_MS=20000
LIVE_EXIT_STATE_REFRESH_MS=30000
LIVE_EXIT_STATE_PATH=/home/USER/.local/state/trading/live-exit-worker-state.json
LIVE_EXIT_WATCHLIST_PATH=/home/USER/.config/trading-live-exit-watchlist.json
# Set only after the existing live-account workflow has been verified for the RPi user.
LIVE_EXIT_POST_FILL_SYNC_COMMAND=
