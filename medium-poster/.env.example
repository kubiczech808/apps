# Google Gemini (GitHub secret: GEMINI_API_KEY_M)
GEMINI_API_KEY=your-gemini-api-key

# Medium (get token from https://medium.com/me/settings/security → scroll to bottom → Integration tokens)
MEDIUM_TOKEN=your-medium-integration-token

# Telegram Bot (GitHub secret: M_TELEGRAM_TOKEN)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Telegram Admin Chat ID (GitHub secret: M_TELEGRAM_CHAT_ID)
TELEGRAM_ADMIN_CHAT_ID=123456789

# Imgur (register app at https://api.imgur.com/oauth2/addclient)
IMGUR_CLIENT_ID=your-imgur-client-id

# Publishing schedule (UTC)
PUBLISH_HOUR=9
PUBLISH_MINUTE=0

# Site
SITE_URL=https://btc-dca.com
SITE_NAME=btc-dca.com

# Optional
LOG_LEVEL=INFO
