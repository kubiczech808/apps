# Google Gemini (GitHub secret: GEMINI_API_KEY_M)
GEMINI_API_KEY=your-gemini-api-key

# Telegram Bot (GitHub secret: M_TELEGRAM_TOKEN)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Telegram Admin Chat ID (GitHub secret: M_TELEGRAM_CHAT_ID)
TELEGRAM_ADMIN_CHAT_ID=123456789

# Imgur (optional — leave empty to skip image upload)
IMGUR_CLIENT_ID=

# GitHub Pages — hosts RSS feed for IFTTT → Medium (GitHub secret: PAT_GITHUB_MEDIUM)
GITHUB_PAT=ghp_your-personal-access-token
GITHUB_PAGES_REPO=kubiczech808/apps
GITHUB_PAGES_BRANCH=gh-pages

# Medium (optional — leave empty if using IFTTT for publishing)
MEDIUM_TOKEN=

# Publishing schedule (UTC)
PUBLISH_HOUR=9
PUBLISH_MINUTE=0

# Site
SITE_URL=https://btc-dca.com
SITE_NAME=btc-dca.com

# Optional
LOG_LEVEL=INFO
