# Google Gemini (GitHub secret: GEMINI_API_KEY_M)
GEMINI_API_KEY=your-gemini-api-key

# Telegram Bot (GitHub secret: M_TELEGRAM_TOKEN)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Telegram Admin Chat ID (GitHub secret: M_TELEGRAM_CHAT_ID)
TELEGRAM_ADMIN_CHAT_ID=123456789

# GitHub Pages — hosts RSS feed (GitHub secret: PAT_GITHUB_MEDIUM)
GITHUB_PAT=ghp_your-personal-access-token
GITHUB_PAGES_REPO=kubiczech808/apps
GITHUB_PAGES_BRANCH=gh-pages

# Dev.to (get from https://dev.to/settings/extensions → DEV API Keys)
DEVTO_API_KEY=

# Hashnode (get from https://hashnode.com/settings/developer)
HASHNODE_TOKEN=
HASHNODE_PUBLICATION_ID=

# Medium via Playwright (RPi5 browser automation — no token needed)
MEDIUM_PLAYWRIGHT=true

# Medium via API (optional — only if you have a legacy token)
MEDIUM_TOKEN=

# Imgur (optional — leave empty to skip images)
IMGUR_CLIENT_ID=

# Publishing schedule (UTC)
PUBLISH_HOUR=9
PUBLISH_MINUTE=0

# Site
SITE_URL=https://btc-dca.com
SITE_NAME=btc-dca.com

# Optional
LOG_LEVEL=INFO
