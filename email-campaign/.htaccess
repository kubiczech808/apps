Options -Indexes

<FilesMatch "^(config\.php|config\.example\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^storage/ - [F,L]
    RewriteRule ^auth/google/callback/?$ index.php?auth=google_callback [L,QSA]
    RewriteRule ^(dashboard|contacts|campaigns|config)/?$ index.php?route=$1 [L,QSA]
</IfModule>
