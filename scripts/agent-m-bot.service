[Unit]
Description=Agent M — Bitcoin DCA Auto-Poster Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jakub
WorkingDirectory=/home/jakub/apps/medium-poster
EnvironmentFile=/home/jakub/apps/medium-poster/.env
ExecStart=/bin/bash -c 'exec /home/jakub/apps/medium-poster/.venv/bin/python -u -m agent_m >> /tmp/agent-m-bot.log 2>&1'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
