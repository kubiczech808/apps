[Unit]
Description=Agent M — Bitcoin DCA Auto-Poster Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jakub
WorkingDirectory=/home/jakub/apps/medium-poster
EnvironmentFile=/home/jakub/apps/medium-poster/.env
ExecStart=/home/jakub/apps/medium-poster/.venv/bin/python -u -m agent_m
Restart=always
RestartSec=10
StandardOutput=append:/tmp/agent-m-bot.log
StandardError=append:/tmp/agent-m-bot.log

[Install]
WantedBy=multi-user.target
