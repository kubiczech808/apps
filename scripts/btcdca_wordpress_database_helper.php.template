<?php
declare(strict_types=1);

// Generated only inside GitHub Actions, uploaded temporarily, then deleted.
$config = json_decode(base64_decode('__CONFIG_BASE64__', true), true, 512, JSON_THROW_ON_ERROR);

if (!hash_equals($config['token'], (string) ($_SERVER['HTTP_X_BTCDCA_TOKEN'] ?? ''))) {
    http_response_code(403);
    exit('Forbidden');
}

mysqli_report(MYSQLI_REPORT_ERROR | MYSQLI_REPORT_STRICT);
try {
    $database = new mysqli('localhost', $config['db_user'], $config['db_password'], $config['db_name']);
} catch (mysqli_sql_exception) {
    http_response_code(500);
    exit('Database connection failed');
}
$database->set_charset('utf8mb4');

function wordpress_tables(mysqli $database): array {
    $prefix = 'wp_dca_';
    $result = $database->query("SHOW TABLES LIKE 'wp\\_dca\\_%'");
    $tables = [];
    while ($row = $result->fetch_row()) {
        $table = (string) $row[0];
        if (!str_starts_with($table, $prefix) || !preg_match('/^wp_dca_[A-Za-z0-9_]+$/', $table)) {
            throw new RuntimeException('Unexpected table name returned by MySQL.');
        }
        $tables[] = $table;
    }
    sort($tables, SORT_STRING);
    return $tables;
}

function identifier(string $value): string {
    return '`' . str_replace('`', '``', $value) . '`';
}

function sql_value(mysqli $database, mixed $value): string {
    if ($value === null) {
        return 'NULL';
    }
    return "'" . $database->real_escape_string((string) $value) . "'";
}

function write_gzip($output, string $contents): void {
    if (gzwrite($output, $contents) === false) {
        throw new RuntimeException('Could not write the WordPress database backup.');
    }
}

function export_wordpress_database(mysqli $database): string {
    $path = tempnam(sys_get_temp_dir(), 'btcdca-wordpress-');
    if ($path === false) {
        throw new RuntimeException('Could not create temporary WordPress database backup.');
    }
    $output = gzopen($path, 'wb9');
    if ($output === false) {
        @unlink($path);
        throw new RuntimeException('Could not open temporary WordPress database backup.');
    }

    try {
        write_gzip($output, "-- BTC-DCA WordPress backup\nSET NAMES utf8mb4;\nSET FOREIGN_KEY_CHECKS=0;\n\n");
        foreach (wordpress_tables($database) as $table) {
            $create = $database->query('SHOW CREATE TABLE ' . identifier($table))->fetch_row();
            if ($create === null || !isset($create[1])) {
                throw new RuntimeException('Could not read the schema for ' . $table . '.');
            }
            write_gzip($output, 'DROP TABLE IF EXISTS ' . identifier($table) . ";\n" . $create[1] . ";\n");
            $result = $database->query('SELECT * FROM ' . identifier($table), MYSQLI_USE_RESULT);
            $fields = [];
            while ($field = $result->fetch_field()) {
                $fields[] = identifier($field->name);
            }
            while ($row = $result->fetch_row()) {
                $values = array_map(fn ($value) => sql_value($database, $value), $row);
                write_gzip($output, 'INSERT INTO ' . identifier($table) . ' (' . implode(', ', $fields) . ') VALUES (' . implode(', ', $values) . ");\n");
            }
            $result->free();
            write_gzip($output, "\n");
        }
        write_gzip($output, "SET FOREIGN_KEY_CHECKS=1;\n");
        if (!gzclose($output)) {
            $output = null;
            throw new RuntimeException('Could not finish the WordPress database backup.');
        }
        $output = null;
        return $path;
    } catch (Throwable $error) {
        if ($output !== null) {
            gzclose($output);
        }
        @unlink($path);
        throw $error;
    }
}

function helper_failure(Throwable $error): never {
    http_response_code(500);
    header('Content-Type: text/plain; charset=utf-8');
    exit('Database helper error: ' . $error->getMessage());
}

try {
    $action = (string) ($_GET['action'] ?? '');
    if ($action === 'export') {
        $path = export_wordpress_database($database);
        header('Content-Type: application/gzip');
        header('Content-Disposition: attachment; filename="btcdca-wordpress.sql.gz"');
        header('Content-Length: ' . (string) filesize($path));
        readfile($path);
        @unlink($path);
        exit;
    }

    if ($action === 'drop' && ($_GET['confirm'] ?? '') === 'RETIRE_WORDPRESS') {
        $tables = wordpress_tables($database);
        foreach ($tables as $table) {
            if (!$database->query('DROP TABLE ' . identifier($table))) {
                throw new RuntimeException('Could not drop ' . $table);
            }
        }
        header('Content-Type: application/json');
        echo json_encode(['dropped' => $tables], JSON_THROW_ON_ERROR);
        exit;
    }

    if ($action === 'restore' && ($_GET['confirm'] ?? '') === 'RESTORE_WORDPRESS') {
    $compressed = file_get_contents('php://input');
    if ($compressed === false || $compressed === '' || strlen($compressed) > 100 * 1024 * 1024) {
        http_response_code(400);
        exit('Missing or oversized WordPress database backup.');
    }
    $sql = gzdecode($compressed);
    if ($sql === false || !str_starts_with($sql, "-- BTC-DCA WordPress backup\n")) {
        http_response_code(400);
        exit('Invalid WordPress database backup.');
    }

    preg_match_all('/(?:DROP TABLE IF EXISTS|CREATE TABLE|INSERT INTO)\\s+`([^`]+)`/i', $sql, $matches);
    if ($matches[1] === []) {
        http_response_code(400);
        exit('WordPress database backup contains no tables.');
    }
    foreach (array_unique($matches[1]) as $table) {
        if (!preg_match('/^wp_dca_[A-Za-z0-9_]+$/', $table)) {
            http_response_code(400);
            exit('WordPress database backup references an unexpected table.');
        }
    }

    // The export deliberately contains one INSERT per row. Execute each statement
    // separately, so a large WordPress post cannot exceed MySQL's packet limit.
    $statement = '';
    $quote = null;
    $escaped = false;
    $executed = 0;
    for ($offset = 0, $length = strlen($sql); $offset < $length; $offset++) {
        $character = $sql[$offset];
        $statement .= $character;
        if ($quote !== null) {
            if ($escaped) {
                $escaped = false;
            } elseif ($character === '\\') {
                $escaped = true;
            } elseif ($character === $quote) {
                $quote = null;
            }
            continue;
        }
        if ($character === "'" || $character === '"' || $character === '`') {
            $quote = $character;
            continue;
        }
        if ($character !== ';') {
            continue;
        }
        $query = trim($statement);
        $statement = '';
        if ($query !== '' && !str_starts_with($query, '--')) {
            if (!$database->query($query)) {
                throw new RuntimeException('Could not restore WordPress database tables: ' . $database->error);
            }
            $executed++;
        }
    }
    if (trim($statement) !== '' || $quote !== null || $executed === 0) {
        throw new RuntimeException('WordPress database backup could not be parsed safely.');
    }

        header('Content-Type: application/json');
        echo json_encode(['restored' => wordpress_tables($database)], JSON_THROW_ON_ERROR);
        exit;
    }

    header('Content-Type: application/json');
    echo json_encode(['tables' => wordpress_tables($database)], JSON_THROW_ON_ERROR);
} catch (Throwable $error) {
    helper_failure($error);
}
